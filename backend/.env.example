# ─────────────────────────────────────────────────────────────────────────────
# Taifer backend — environment variables
#
# Copy to .env for local development. Every variable below is read by
# src/config/env.js, which validates the whole set at boot and refuses to start
# if something required is missing or malformed. Nothing here is optional by
# accident: if a value is optional, the feature it powers degrades gracefully.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info                       # trace|debug|info|warn|error|fatal
# Public base URL of this API. Used in emails (opt-in links) and OpenAPI docs.
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the marketing site. Used in emails and CORS defaults.
SITE_PUBLIC_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Use a DIFFERENT database per environment. Never point staging at production.
MONGODB_URI=mongodb://127.0.0.1:27017/taifer_dev
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# ── Redis (cache, rate limiting, queues) ─────────────────────────────────────
# Leave REDIS_URL empty to run without Redis: caching is bypassed, rate limiting
# falls back to per-instance in-memory counters, and queued jobs are executed
# inline. Acceptable for local dev and tests; NOT acceptable in production
# (the app logs a fatal warning at boot if this is empty while NODE_ENV=production).
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=taifer
CACHE_TTL_SECONDS=300

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters-long
# Cookie domain for the refresh token. Leave empty for host-only cookies.
COOKIE_DOMAIN=
# Failed-login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Field-level encryption (ID documents, payment references) ────────────────
# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required only once you start storing sensitive fields; leave empty otherwise.
FIELD_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. Never "*" — credentials are sent cross-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=300            # requests per window per IP, all routes
RATE_LIMIT_GLOBAL_WINDOW=1 minute
RATE_LIMIT_LEADS_MAX=5               # lead submissions per window per IP
RATE_LIMIT_LEADS_WINDOW=10 minutes
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=15 minutes

# ── Spam protection ──────────────────────────────────────────────────────────
# reCAPTCHA v3 (invisible). Leave empty to disable the check entirely.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ── Email (transactional) ────────────────────────────────────────────────────
# EMAIL_PROVIDER: resend | sendgrid | postmark | console
# "console" logs the message instead of sending — the default for local dev.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Taifer <hello@taifer.com>"
EMAIL_REPLY_TO=hello@taifer.com
# Where new-lead alerts are sent. Comma-separated.
LEAD_ALERT_EMAILS=sales@taifer.com

# ── WhatsApp / SMS lead alerts ───────────────────────────────────────────────
# WHATSAPP_PROVIDER: meta | twilio | none
WHATSAPP_PROVIDER=none
# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
# Twilio (used when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
# Comma-separated E.164 numbers that receive instant lead alerts
LEAD_ALERT_PHONES=

# ── File storage (S3-compatible: AWS S3, Cloudflare R2) ──────────────────────
S3_ENDPOINT=                         # empty for AWS S3; set for R2/MinIO
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL images are served from (CDN domain in front of the bucket)
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=5242880             # 5 MB

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Data retention / compliance ──────────────────────────────────────────────
# Leads not converted and untouched for this long are anonymised by the
# retention job. Set to 0 to disable automatic anonymisation.
LEAD_RETENTION_DAYS=730
# Unconfirmed newsletter subscribers are deleted after this long.
NEWSLETTER_UNCONFIRMED_RETENTION_DAYS=30

# ── Feature flags ────────────────────────────────────────────────────────────
# Emergency switch: when true, write endpoints return 503 with a friendly
# message instead of failing silently. Flags can also be toggled at runtime
# from the admin dashboard (stored in MongoDB); this is the boot default.
MAINTENANCE_MODE=false
