# Conservative headers only. Nothing here can break a page that already works:
# no CSP, because the site loads Unsplash images, Google Fonts and a map tile
# provider, and a policy written blind would block one of them in production
# and nowhere else.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Vite fingerprints these, so they can be cached hard and forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
