# Frontend environment variables.
#
# Vite only exposes variables prefixed with VITE_ to the browser, so nothing
# secret belongs in this file — anything here ships in the JS bundle.

# Base URL of the backend API.
#
# Leave it unset in development: vite.config.js proxies /api to the local
# backend, which keeps the browser treating the API as same-origin.
#
# In production, set it only if the API is on a different host from the site.
# Same-origin (a /api path on your own domain, via a CDN or reverse proxy) is
# preferable: it avoids CORS entirely and keeps cookies simple.
# VITE_API_URL=https://api.taifer.com/api/v1
